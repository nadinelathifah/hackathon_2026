{
  "name": "ibex-smart-contract-demo",
  "version": "1.0.0",
  "description": "Ibex Credit smart contract demo using Polygon as a tamper-evident audit layer for ML-generated credit score proofs.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "demo": "hardhat run scripts/demoLocalFlow.js",
    "demo:v2": "hardhat run scripts/v2/demoLocalFlowV2.js",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "add-issuer:amoy": "hardhat run scripts/addIssuer.js --network amoy",
    "submit:amoy": "hardhat run scripts/submitScoreRoot.js --network amoy",
    "read:amoy": "hardhat run scripts/readLatestRecord.js --network amoy",
    "verify:amoy": "hardhat run scripts/verifyScoreEvent.js --network amoy",
    "wallet:amoy": "hardhat run scripts/checkWallet.js --network amoy",
    "deploy:v2:amoy": "hardhat run scripts/v2/deployV2.js --network amoy",
    "submit:v2:amoy": "hardhat run scripts/v2/submitScoreRootV2.js --network amoy",
    "read:v2:amoy": "hardhat run scripts/v2/readLatestRecordV2.js --network amoy",
    "verify:v2:amoy": "hardhat run scripts/v2/verifyScoreEventV2.js --network amoy",
    "admin:v2:amoy": "hardhat run scripts/v2/manageRegistryV2.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "add-issuer:polygon": "hardhat run scripts/addIssuer.js --network polygon",
    "submit:polygon": "hardhat run scripts/submitScoreRoot.js --network polygon",
    "read:polygon": "hardhat run scripts/readLatestRecord.js --network polygon",
    "verify:polygon": "hardhat run scripts/verifyScoreEvent.js --network polygon",
    "wallet:polygon": "hardhat run scripts/checkWallet.js --network polygon",
    "deploy:v2:polygon": "hardhat run scripts/v2/deployV2.js --network polygon",
    "submit:v2:polygon": "hardhat run scripts/v2/submitScoreRootV2.js --network polygon",
    "read:v2:polygon": "hardhat run scripts/v2/readLatestRecordV2.js --network polygon",
    "verify:v2:polygon": "hardhat run scripts/v2/verifyScoreEventV2.js --network polygon",
    "admin:v2:polygon": "hardhat run scripts/v2/manageRegistryV2.js --network polygon"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "16.4.7",
    "ethers": "6.14.0",
    "merkletreejs": "0.3.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "hardhat": "2.28.0"
  }
}
